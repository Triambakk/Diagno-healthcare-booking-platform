# ------------------------------------------------------------------
# DIAGNO — Diagnostic Appointment Booking Platform
# Environment Configuration Template
# ------------------------------------------------------------------

# Database Configuration (PostgreSQL / Hosted PostgreSQL)
# Option A: Connection URL (e.g. Neon, Supabase, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/diagnostic_booking

# Option B: Individual database parameters (used if DATABASE_URL is not provided)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=diagnostic_booking
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Django Security & Core Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
